<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="co.ltlabs.ui.main.lineleader.LineListWindowFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white">

        <TextView
            android:id="@+id/btnCancelTicket"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/popup_label_select_lines_margin_start"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/popup_label_select_lines_margin_end"
            android:layout_marginBottom="20dp"
            android:fontFamily="@font/segoeui"
            android:gravity="center"
            android:text="CANCEL TICKET"
            android:textColor="@color/textButtonColor"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textView12"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnAlternativeMachine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/popup_label_select_lines_margin_start"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/popup_label_select_lines_margin_end"
            android:fontFamily="@font/segoeui"
            android:gravity="center"
            android:text="SEE ALTERNATIVE MACHINES"
            android:textColor="@color/textButtonColor"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnMachineHistory" />

        <TextView
            android:id="@+id/btnMachineHistory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/popup_label_select_lines_margin_start"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/popup_label_select_lines_margin_end"
            android:fontFamily="@font/segoeui"
            android:gravity="center"
            android:text="MACHINE HISTORY"
            android:textColor="@color/textButtonColor"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textView12"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="20dp"
            android:background="@android:color/darker_gray"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnAlternativeMachine" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

