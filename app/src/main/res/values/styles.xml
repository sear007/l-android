<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorButton</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/dark_sky_blue</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowActionBarOverlay">true</item>

    </style>

    <style name="DropDownStyle" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--        <item name="android:spinnerItemStyle">@style/spinnerItemStyle</item>-->
        <item name="android:spinnerDropDownItemStyle">
            @style/spinnerDropDownItemStyle
        </item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="spinnerItemStyle">
        <item name="android:gravity">center</item>
    </style>

    <style name="spinnerDropDownItemStyle">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="ErrorMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/errorMessage</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <style name="EditTextTheme">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="hintTextColor">@color/hintColor</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:background">@drawable/bg_input_text</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="AppTheme.DialogStyle" parent="Base.Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/scale_in</item>
        <item name="android:windowExitAnimation">@anim/scale_out</item>
    </style>

</resources>
