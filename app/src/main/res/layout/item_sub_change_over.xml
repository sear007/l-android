<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#324C5D">

        <View
            android:id="@+id/v_color"
            android:layout_width="@dimen/margin_1x"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="#4CAF50" />

        <TextView
            android:id="@+id/tv_co"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4x"
            android:layout_marginTop="@dimen/margin_2x"
            android:fontFamily="@font/roboto_bold"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_x_normal"
            app:layout_constraintStart_toEndOf="@id/v_color"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="C2203220001" />

        <TextView
            android:id="@+id/tv_style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_1x"
            android:fontFamily="@font/roboto_light"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="@id/tv_co"
            app:layout_constraintTop_toBottomOf="@id/tv_co"
            tools:text="FW2424318A" />

        <TextView
            android:id="@+id/tv_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2x"
            android:fontFamily="@font/roboto_light"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_co"
            app:layout_constraintTop_toBottomOf="@id/tv_style"
            tools:text="YTI-13" />

        <View
            android:id="@+id/v_separate"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/margin_2x"
            android:background="#8A969E99"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4x"
            android:layout_marginTop="@dimen/margin_2x"
            android:fontFamily="@font/roboto_bold"
            android:text="C"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_x_normal"
            app:layout_constraintStart_toEndOf="@id/v_separate"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_6x"
            android:layout_marginTop="@dimen/margin_2x"
            android:layout_marginEnd="@dimen/margin_6x"
            android:background="@drawable/rounded"
            android:fontFamily="@font/roboto_bold"
            android:gravity="center"
            android:padding="@dimen/padding_1x"
            android:textColor="#F57C00"
            android:textSize="@dimen/text_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_type"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="IN PROGRESS" />

        <TextView
            android:id="@+id/tv_machine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_1x"
            android:fontFamily="@font/roboto_bold"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_x_normal"
            app:layout_constraintStart_toStartOf="@id/tv_type"
            app:layout_constraintTop_toBottomOf="@id/tv_type"
            tools:text="M/C: 18" />

        <TextView
            android:id="@+id/tv_machine_critical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_1x"
            android:drawablePadding="@dimen/padding_2x"
            android:fontFamily="@font/roboto_bold"
            android:text="@string/in_repair_tickets_count"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_x_normal"
            app:drawableStartCompat="@drawable/ic_critical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_machine"
            app:layout_constraintTop_toBottomOf="@id/tv_type" />

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_2x"
            android:fontFamily="@font/roboto_light"
            android:textColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_type"
            app:layout_constraintTop_toBottomOf="@id/tv_machine"
            tools:text="2022-04-18 12:01" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>