                android:layout_marginBottom="10dp"
                android:elevation="1dp"
                android:fontFamily="@font/segoeui"
                android:text="@string/machines_count"
                android:textColor="#FFF"
                android:textSize="50sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnLLMachines"
                app:layout_constraintEnd_toEndOf="@+id/btnLLMachines"
                app:layout_constraintHorizontal_bias="0.78"
                app:layout_constraintStart_toEndOf="@+id/machinesTextViewLL"
                app:layout_constraintTop_toTopOf="@+id/btnLLMachines"
                tools:text="@string/machines_count" />

            <ImageView
                android:id="@+id/btnLLQueryMachine"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginStart="@dimen/dashboard_margin_start_end"
                android:layout_marginTop="@dimen/dashboard_button_margin_top"
                android:layout_marginEnd="@dimen/dashboard_margin_start_end"
                android:scaleType="fitXY"
                android:src="@drawable/dashboard_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLLMachines" />

            <TextView
                android:id="@+id/queryMachineTextViewLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="1dp"
                android:fontFamily="@font/segoeui"
                android:text="@string/query_machine"
                android:textColor="#FFF"
                android:textSize="23sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnLLQueryMachine"
                app:layout_constraintEnd_toEndOf="@+id/btnLLQueryMachine"
                app:layout_constraintHorizontal_bias="0.068"
                app:layout_constraintStart_toStartOf="@+id/btnLLQueryMachine"
                app:layout_constraintTop_toTopOf="@+id/btnLLQueryMachine"
                app:layout_constraintVertical_bias="0.555" />

            <ImageView
                android:id="@+id/btnLLSendRequest"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_marginStart="@dimen/dashboard_margin_start_end"
                android:layout_marginTop="@dimen/dashboard_button_margin_top"
                android:layout_marginEnd="@dimen/dashboard_margin_start_end"
                android:scaleType="fitXY"
                android:src="@drawable/dashboard_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLLQueryMachine" />

            <TextView
                android:id="@+id/sendRequestTextViewLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="1dp"
                android:fontFamily="@font/segoeui"
                android:text="@string/send_request"
                android:textColor="#FFF"
                android:textSize="23sp"
                app:layout_constraintBottom_toBottomOf="@+id/btnLLSendRequest"
                app:layout_constraintEnd_toEndOf="@+id/btnLLSendRequest"
                app:layout_constraintHorizontal_bias="0.068"
                app:layout_constraintStart_toStartOf="@+id/btnLLSendRequest"
                app:layout_constraintTop_toTopOf="@+id/btnLLSendRequest"
                app:layout_constraintVertical_bias="0.555" />

            <TextView
                android:id="@+id/usernameTextViewLL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="30dp"
                android:fontFamily="@font/segoeui"
                android:text="@string/username"
                android:textColor="#FFF"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLLSendRequest" />
